# ServerManager - example settings. Copy to .env and fill in the first four values.
# (The `AX-Manager install` command creates this file for you.)

# --- required -----------------------------------------------------------------
BOT_TOKEN=
ADMIN_ID=
# Password used to encrypt backup files (at least 8 characters; avoid spaces, quotes, # and $).
BACKUP_PASSPHRASE=

# --- optional -----------------------------------------------------------------
# Name shown in the bot's messages.
BOT_NAME=ServerManager
# Telegram username users can contact (shows a "Support" button). Leave empty to hide it.
SUPPORT_USERNAME=
TZ=UTC
BACKUP_INTERVAL_HOURS=24
MAX_LIVE_SESSIONS=20
IDLE_TIMEOUT_MIN=10
MAX_SESSION_HOURS=2

# --- availability alerts ------------------------------------------------------
WATCH_INTERVAL_MIN=5
MAX_WATCH_PER_USER=10

# --- network safety -----------------------------------------------------------
# Extra IPs users must never be able to connect to (comma separated), e.g. this server's public IP.
BLOCKED_IPS=
# Private ranges users MAY connect to (comma separated CIDRs), e.g. a LAN or a VPN: 10.8.0.0/24,100.64.0.0/10
# Loopback and link-local (cloud metadata) addresses can never be allowed.
ALLOWED_NETS=

# --- "This server" access (admin only) ----------------------------------------
# Managed by `AX-Manager host-access enable|disable`; you normally don't edit these by hand.
HOST_ACCESS=0
HOST_SSH_ADDR=host.docker.internal
HOST_SSH_PORT=22
HOST_SSH_USER=root
HOST_SSH_FINGERPRINT=

# --- used by the installer's docker-compose.yml ---------------------------------
SM_SUBNET=172.28.77.0/24
